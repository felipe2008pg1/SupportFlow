# Copy to .env (in this backend/ folder) and fill in real values.
# .env is gitignored — never commit it.

ENVIRONMENT=development
DEBUG=true

# Comma-separated list, no trailing slashes, no wildcard.
# Must match the origin the frontend is actually served from.
ALLOWED_ORIGINS=http://localhost:8080

# Must match POSTGRES_* below when running via docker-compose.
DATABASE_URL=postgresql+psycopg://supportflow:CHANGE_ME@db:5432/supportflow

POSTGRES_USER=supportflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=supportflow
